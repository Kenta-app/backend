{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kenta Stance Peru v1 pair",
  "type": "object",
  "required": [
    "pair_id", "corpus_version", "intended_use", "batch_id", "group_id",
    "article_id", "source_name", "claim", "article", "quality_status"
  ],
  "properties": {
    "pair_id": {"type": "string", "minLength": 1},
    "corpus_version": {"const": "stance_es_pe_v1"},
    "intended_use": {"enum": ["development", "train_candidate", "validation_candidate", "test_candidate"]},
    "batch_id": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string"},
    "claim_id": {"type": "string"},
    "article_id": {"type": "string", "minLength": 1},
    "pair_construction": {"type": "string"},
    "source_name": {"type": "string", "minLength": 1},
    "ownership_group": {"type": "string"},
    "title": {"type": "string"},
    "original_url": {"type": "string"},
    "published_at": {"type": "string"},
    "collected_at": {"type": "string"},
    "collection_method": {"type": "string"},
    "article_sha256": {"type": "string"},
    "claim": {"type": "string", "minLength": 1},
    "article": {"type": "string", "minLength": 1},
    "annotator_1": {"type": "string"},
    "label_annotator_1": {"enum": ["", "agree", "disagree", "discuss", "unrelated"]},
    "evidence_annotator_1": {"type": "string"},
    "confidence_annotator_1": {"enum": ["", "alta", "media", "baja"]},
    "annotator_2": {"type": "string"},
    "label_annotator_2": {"enum": ["", "agree", "disagree", "discuss", "unrelated"]},
    "evidence_annotator_2": {"type": "string"},
    "confidence_annotator_2": {"enum": ["", "alta", "media", "baja"]},
    "adjudicated_label": {"enum": ["", "agree", "disagree", "discuss", "unrelated", "exclude"]},
    "adjudication_note": {"type": "string"},
    "final_label": {"enum": ["", "agree", "disagree", "discuss", "unrelated"]},
    "quality_status": {"enum": ["include", "review", "exclude"]},
    "quality_flags": {"type": "string"},
    "split": {"enum": ["", "train", "validation", "test"]}
  },
  "additionalProperties": true
}
