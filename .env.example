# Copia este archivo a .env y completa los valores antes de desplegar.
# En Docker Compose, DATABASE_URL se construye internamente usando postgres.
DATABASE_URL=

POSTGRES_DB=kenta
POSTGRES_USER=kenta_app
POSTGRES_PASSWORD=
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGINS=
API_DOCS_ENABLED=false
FRONTEND_API_PROXY_TARGET=https://api.ikenta.app
# Usa nginx.ssl.conf después de emitir el certificado con Certbot.
NGINX_CONFIG_FILE=nginx.ssl.conf

# Resend: crea una API key y verifica ikenta.app en Resend antes de activar registro.
RESEND_API_KEY=
EMAIL_FROM=Kenta <verificacion@ikenta.app>
# Correo interno opcional que recibe el celular confirmado por el ganador del sorteo.
KENTA_DRAW_NOTIFICATION_EMAIL=
# Solo para pruebas locales controladas. En producción usar el ganador predeterminado.
KENTA_DRAW_WINNER_EMAIL=
# Genera un secreto aleatorio largo; no lo compartas ni lo subas a Git.
EMAIL_VERIFICATION_SECRET=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=12
AUTH_REMEMBER_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
FRONTEND_PUBLIC_URL=https://ikenta.app
# Recordatorio único y voluntario para participantes de la validación.
STUDY_REMINDER_ENABLED=false
STUDY_REMINDER_DELAY_HOURS=48
STUDY_REMINDER_SCHEDULE_MINUTE=15
STUDY_REMINDER_BATCH_SIZE=20
STUDY_REMINDER_RETRY_HOURS=6
STUDY_REMINDER_MAX_ATTEMPTS=3

ENABLE_SCHEDULER=true
ML_WARMUP_ON_STARTUP=true
# Opcional: dos ejecuciones diarias, p. ej. 8,20 con minuto 30 (hora de Lima).
# Si queda vacío, se usa SCRAPING_SCHEDULE_HOUR como antes.
SCRAPING_SCHEDULE_HOURS=
SCRAPING_SCHEDULE_HOUR=
SCRAPING_SCHEDULE_MINUTE=
SCRAPER_MAX_ARTICLES_PER_SOURCE=10

FAKENEWS_MODEL_DIR=
# Umbral binario del clasificador y límites de la política pública de tres niveles.
FAKENEWS_ARTICLE_RISK_THRESHOLD=0.5
FAKENEWS_ARTICLE_LOW_THRESHOLD=0.35
FAKENEWS_ARTICLE_HIGH_THRESHOLD=0.75
FAKENEWS_USE_CLAIMS=true
CLUSTERING_SIMILARITY_THRESHOLD=0.40
TWITTER_BEARER_TOKEN=
TWITTER_MAX_RESULTS=10
# Publicaciones políticas peruanas recientes en español; excluye retuits y respuestas.
TWITTER_SEARCH_QUERY="(Perú OR peruano) (Congreso OR Gobierno OR elecciones OR política OR presidenta OR presidente) lang:es -is:retweet -is:reply"
STANCE_MODEL_DIR=output/stance_es_pe_v1/final_model_2026_09_28/best_model
# Mantener en false hasta superar los criterios de despliegue documentados.
STANCE_PUBLIC_ENABLED=false

SUMMARIZER_MODEL_NAME=ELiRF/mt5-base-dacsa-es
SUMMARY_INLINE_ENABLED=false
SUMMARY_MAX_CONCURRENT_GENERATIONS=1
SUMMARY_NUM_BEAMS=4
SUMMARY_MIN_CHARS=700
SUMMARY_MAX_INPUT_LENGTH=1024
SUMMARY_MAX_LENGTH=150
SUMMARY_MIN_LENGTH=60

GEMINI_API_KEY=
JUSTIFICATION_AUTO_ENABLED=false
# Límite global de llamadas automáticas a Gemini por cada ciclo de scraping.
JUSTIFICATION_MAX_PER_SCHEDULED_RUN=5
JUSTIFICATION_MODEL=gemini-3.5-flash-lite
JUSTIFICATION_MAX_SOURCES=4
JUSTIFICATION_VALIDATE_URLS=true
RELATED_CLUSTER_MIN_SCORE=0.60
JUSTIFICATION_CACHE_TTL=3600
JUSTIFICATION_MAX_RETRIES=3
JUSTIFICATION_RETRY_DELAY=2
RELATED_SOURCES_LIMIT=20
RELATED_SOURCES_SLEEP=2
