# Copia este archivo a .env y completa los valores antes de desplegar.
# En Docker Compose, DATABASE_URL se construye internamente usando postgres.
DATABASE_URL=

POSTGRES_DB=kenta
POSTGRES_USER=kenta_app
POSTGRES_PASSWORD=
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGINS=
FRONTEND_API_PROXY_TARGET=https://api.ikenta.app
# Usa nginx.ssl.conf después de emitir el certificado con Certbot.
NGINX_CONFIG_FILE=nginx.ssl.conf

# Resend: crea una API key y verifica ikenta.app en Resend antes de activar registro.
RESEND_API_KEY=
EMAIL_FROM=Kenta <verificacion@ikenta.app>
# Genera un secreto aleatorio largo; no lo compartas ni lo subas a Git.
EMAIL_VERIFICATION_SECRET=
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

ENABLE_SCHEDULER=true
ML_WARMUP_ON_STARTUP=true
SCRAPING_SCHEDULE_HOUR=
SCRAPING_SCHEDULE_MINUTE=

FAKENEWS_MODEL_DIR=
FAKENEWS_ARTICLE_LOW_THRESHOLD=
FAKENEWS_ARTICLE_HIGH_THRESHOLD=
FAKENEWS_USE_CLAIMS=
TWITTER_BEARER_TOKEN=
TWITTER_MAX_RESULTS=10
STANCE_MODEL_DIR=

SUMMARIZER_MODEL_NAME=facebook/bart-large-cnn
SUMMARY_INLINE_ENABLED=false
SUMMARY_MAX_CONCURRENT_GENERATIONS=1
SUMMARY_NUM_BEAMS=4
SUMMARY_MIN_CHARS=700

GEMINI_API_KEY=
JUSTIFICATION_AUTO_ENABLED=false
JUSTIFICATION_CACHE_TTL=3600
JUSTIFICATION_MAX_RETRIES=3
JUSTIFICATION_RETRY_DELAY=2
